<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <EnableComHosting>true</EnableComHosting>
    <GenerateComInterfaceMetadata>true</GenerateComInterfaceMetadata>
  </PropertyGroup>
  <PropertyGroup>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <DefineConstants>$(DefineConstants);DESKBAND_WPF</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EverythingToolbar\EverythingToolbar.csproj" />
    <ProjectReference Include="..\EverythingToolbar.Core\EverythingToolbar.Core.csproj" />
    <ProjectReference Include="..\EverythingToolbar.Platform\EverythingToolbar.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="EverythingToolbar.App" />
    <Using Include="EverythingToolbar.App.Data" />
    <Using Include="EverythingToolbar.App.Helpers" />
    <Using Include="EverythingToolbar.App.Search" />
    <Using Include="EverythingToolbar.Services" />
    <Using Include="EverythingToolbar.Core.Helpers" />
    <Using Include="EverythingToolbar.Core.Search" />
    <Using Include="EverythingToolbar.Core.Services" />
    <Using Include="EverythingToolbar.Platform.Helpers" />
    <Using Include="EverythingToolbar.Platform.Search" />
  </ItemGroup>
  <Target
    Name="AddRuntimeDependenciesToContent"
    Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'"
    BeforeTargets="GetCopyToOutputDirectoryItems"
  >
    <ItemGroup>
      <ContentWithTargetPath
        Include="$(ProjectDepsFilePath)"
        CopyToOutputDirectory="PreserveNewest"
        TargetPath="$(ProjectDepsFileName)"
      />
      <ContentWithTargetPath
        Include="$(ProjectRuntimeConfigFilePath)"
        CopyToOutputDirectory="PreserveNewest"
        TargetPath="$(ProjectRuntimeConfigFileName)"
      />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="NLog" />
  </ItemGroup>
  <Target Name="StopExplorerIfDeskbandLoaded" BeforeTargets="PreBuildEvent">
    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\tools\stop_explorer_if_locked.ps1&quot; -TargetDir &quot;$(TargetDir.TrimEnd('\'))&quot;"
      ContinueOnError="true"
    />
  </Target>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PreBuildEvent>xcopy $(SolutionDir)EverythingSDK\x64\$(Configuration)\Everything64.dll $(TargetDir) /r /y
      xcopy $(SolutionDir)EverythingSDK3\x64\$(Configuration)\Everything3.dll $(TargetDir) /r /y
Exit 0</PreBuildEvent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='ARM64'">
    <PreBuildEvent>xcopy $(SolutionDir)EverythingSDK\ARM64\$(Configuration)\Everything64.dll $(TargetDir) /r /y
      xcopy $(SolutionDir)EverythingSDK3\ARM64\$(Configuration)\Everything3.dll $(TargetDir) /r /y
Exit 0</PreBuildEvent>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Only bring Explorer back if it was actually stopped (also covers a failed build). -->
    <PostBuildEvent>powershell -NoProfile -Command "if (-not (Get-Process -Name explorer -ErrorAction SilentlyContinue)) { Start-Process $env:windir\explorer.exe }"
Exit 0</PostBuildEvent>
  </PropertyGroup>
</Project>
