<UserControl x:Class="EverythingToolbar.Deskband.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EverythingToolbar.Controls;assembly=EverythingToolbar">

    <!-- Use the unified ToolbarControl from main project in responsive mode -->
    <controls:ToolbarControl x:Name="UnifiedToolbarControl"
                            IsFixedLayout="False"
                            AddPlacementBehavior="True" />
    
</UserControl>
