<UserControl
  x:Class="EverythingToolbar.Controls.FilterSelector"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Name="Root"
  Background="Transparent">
  <UserControl.OpacityMask>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
      <GradientStop Offset="0" Color="Black" />
      <GradientStop Offset="0.94" Color="Black" />
      <GradientStop Offset="1" Color="Transparent" />
    </LinearGradientBrush>
  </UserControl.OpacityMask>
  <StackPanel Orientation="Horizontal">
    <TabControl
      x:Name="TabControl"
      FocusVisualStyle="{x:Null}"
      ItemsSource="{Binding FilterProvider.VisibleFilters}"
      SelectedIndex="-1"
      SelectionChanged="OnTabItemSelected" />

    <ComboBox
      Name="ComboBox"
      DisplayMemberPath="Name"
      FocusVisualStyle="{x:Null}"
      ItemsSource="{Binding FilterProvider.OverflowFilters}"
      SelectedIndex="-1"
      SelectionChanged="OnComboBoxItemSelected" />
  </StackPanel>
</UserControl>
