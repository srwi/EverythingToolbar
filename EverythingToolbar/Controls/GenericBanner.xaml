<UserControl
  x:Class="EverythingToolbar.Controls.GenericBanner"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  FontSize="13">
  <UserControl.Resources>
    <Style x:Key="BannerButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12 6" />
      <Setter Property="MinWidth" Value="60" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ButtonBorderBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ButtonBorderBrush}" />
                <Setter Property="Opacity" Value="0.8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border
    MinHeight="50"
    Margin="{DynamicResource UpdateBannerMargin}"
    Background="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=BannerColor}"
    CornerRadius="{DynamicResource UpdateBannerCornerRadius}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="16 10 60 10" VerticalAlignment="Center">
        <TextBlock
          Name="BannerHeadlineBlock"
          Margin="0 0 0 4"
          FontWeight="Medium"
          Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=Headline}"
          TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=Headline}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=Headline}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock
          Name="BannerTextBlock"
          Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=Text}"
          TextWrapping="Wrap" />
      </StackPanel>
      <Button
        Name="SecondaryButton"
        Grid.Column="1"
        Margin="8 10"
        Click="OnSecondaryButtonClicked"
        Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=SecondaryButtonText}"
        Style="{StaticResource BannerButtonStyle}" />
      <Button
        Name="PrimaryButton"
        Grid.Column="2"
        Margin="8 10 16 10"
        Click="OnPrimaryButtonClicked"
        Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=PrimaryButtonText}"
        Style="{StaticResource BannerButtonStyle}" />
    </Grid>
  </Border>
</UserControl>
