<UserControl x:Class="EverythingToolbar.Controls.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
             xmlns:search="clr-namespace:EverythingToolbar.Search"
             xmlns:controls="clr-namespace:EverythingToolbar.Controls"
             xmlns:converters="clr-namespace:EverythingToolbar.Converters"
             HorizontalAlignment="Stretch"
             KeyDown="OnKeyDown"
             GotFocus="OnGotFocus">
    
    <i:Interaction.Behaviors>
        <b:ThemeAwareness />
    </i:Interaction.Behaviors>

    <UserControl.Resources>
        <converters:SearchControlVisibilityConverter
            x:Key="SearchButtonDoubleToVisibilityConverter"
            VisibilityThreshold="-70"
            AlwaysVisibleWithAutoHidingTaskbar="True" />
        <converters:SearchControlVisibilityConverter
            x:Key="SearchBoxDoubleToVisibilityConverter"
            VisibilityThreshold="70"
            AlwaysVisibleWithAutoHidingTaskbar="False" />
        
        <Style x:Key="FixedLayoutGrid" TargetType="Grid">
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        
        <Style x:Key="ResponsiveLayoutGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{DynamicResource ResponsiveLayoutGrid}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <TextBox Opacity="0"
                 IsHitTestVisible="False"
                 Name="KeyboardFocusCapture"
                 Grid.ColumnSpan="3" />

        <!-- Search Icon - only visible in fixed layout mode -->
        <Image x:Name="SearchIcon"
               Grid.Column="0" 
               Source="/Images/Icons/Search.png"
               Width="16" 
               Height="16" 
               Margin="4,0,6,0"
               VerticalAlignment="Center"
               Visibility="Collapsed" />

        <controls:SearchBox x:Name="SearchBox"
                            Grid.Column="1"
                            Visibility="{Binding Path=ActualWidth,
                                                 RelativeSource={RelativeSource Self},
                                                 Converter={StaticResource SearchBoxDoubleToVisibilityConverter}}"
                            SearchTerm="{Binding Source={x:Static search:SearchState.Instance}, Path=SearchTerm, Mode=TwoWay}"
                            GotKeyboardFocus="OnSearchBoxGotKeyboardFocus"
                            LostKeyboardFocus="OnSearchBoxLostKeyboardFocus"/>

        <controls:SearchButton x:Name="SearchButton"
                               Grid.Column="2"
                               Visibility="{Binding Path=ActualWidth,
                                                    RelativeSource={RelativeSource Self},  
                                                    Converter={StaticResource SearchButtonDoubleToVisibilityConverter}}" />
    </Grid>
    
</UserControl>
