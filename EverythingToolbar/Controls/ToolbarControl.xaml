<UserControl x:Class="EverythingToolbar.Controls.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
             xmlns:markup="clr-namespace:EverythingToolbar.Markup"
             xmlns:search="clr-namespace:EverythingToolbar.Search"
             xmlns:appsearch="clr-namespace:EverythingToolbar.App.Search;assembly=EverythingToolbar.App"
             xmlns:controls="clr-namespace:EverythingToolbar.Controls"
             xmlns:converters="clr-namespace:EverythingToolbar.Converters"
             HorizontalAlignment="Stretch"
             KeyDown="OnKeyDown"
             GotFocus="OnGotFocus">
    
    <i:Interaction.Behaviors>
        <b:Themed Surface="TaskbarSurface" />
    </i:Interaction.Behaviors>

    <UserControl.Resources>
        <converters:SearchControlVisibilityConverter
            x:Key="SearchButtonDoubleToVisibilityConverter"
            VisibilityThreshold="-70"
            AlwaysVisibleWithAutoHidingTaskbar="True" />
        <converters:SearchControlVisibilityConverter
            x:Key="SearchBoxDoubleToVisibilityConverter"
            VisibilityThreshold="70"
            AlwaysVisibleWithAutoHidingTaskbar="False" />
    </UserControl.Resources>

    <!-- SearchBox and SearchButton overlap in a single cell and both stretch to the full width.
         The +70 / -70 thresholds evaluated against that shared width make them mutually exclusive:
         the box shows when the toolbar is wide, the icon (centered) when it is narrow. Keeping them
         in separate columns breaks the trick (the button's Auto width is constant) and the centering. -->
    <Grid>
        <TextBox Opacity="0"
                 IsHitTestVisible="False"
                 Name="KeyboardFocusCapture" />

        <controls:SearchBox x:Name="SearchBox"
                            Visibility="{Binding Path=ActualWidth,
                                                 RelativeSource={RelativeSource Self},
                                                 Converter={StaticResource SearchBoxDoubleToVisibilityConverter}}"
                            SearchTerm="{Binding Source={markup:Service {x:Type appsearch:SearchState}}, Path=SearchTerm, Mode=TwoWay}"
                            GotKeyboardFocus="OnSearchBoxGotKeyboardFocus"
                            LostKeyboardFocus="OnSearchBoxLostKeyboardFocus"/>

        <controls:SearchButton x:Name="SearchButton"
                               Visibility="{Binding Path=ActualWidth,
                                                    RelativeSource={RelativeSource Self},
                                                    Converter={StaticResource SearchButtonDoubleToVisibilityConverter}}" />
    </Grid>
    
</UserControl>
