<Button
  x:Class="EverythingToolbar.Controls.SearchButton"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:markup="clr-namespace:EverythingToolbar.Markup"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:properties="clr-namespace:EverythingToolbar.Properties"
  xmlns:services="clr-namespace:EverythingToolbar.Services"
  d:DesignHeight="40"
  d:DesignWidth="50"
  Click="OnClick"
  IsVisibleChanged="OnIsVisibleChanged"
  Style="{DynamicResource SearchButtonStyle}"
  ToolTip="{x:Static properties:Resources.TextBoxWatermark}"
  mc:Ignorable="d">
  <Button.Resources>
    <Style x:Key="SearchButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid>
              <Border
                x:Name="OuterBorder"
                Background="Transparent"
                Opacity="0.55"
                SnapsToDevicePixels="True">
                <Border
                  x:Name="InnerBorder"
                  Background="Transparent"
                  SnapsToDevicePixels="True" />
              </Border>
              <Path
                Width="16"
                Height="18"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="1">
                <Path.Data>
                  <GeometryGroup>
                    <LineGeometry StartPoint="0, 17" EndPoint="6, 11" />
                    <EllipseGeometry
                      Center="10, 7"
                      RadiusX="5.3"
                      RadiusY="5.3" />
                  </GeometryGroup>
                </Path.Data>
              </Path>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="OuterBorder" Property="Background" Value="#40ffffff" />
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                  <Condition Binding="{Binding Source={markup:Service {x:Type services:WindowsPolicy}}, Path=IsEffectiveAnimationsDisabled}" Value="False" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation
                        Storyboard.TargetName="InnerBorder"
                        Storyboard.TargetProperty="Background.Color"
                        To="#99ffffff"
                        Duration="0" />
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation
                        Storyboard.TargetName="InnerBorder"
                        Storyboard.TargetProperty="Background.Color"
                        To="Transparent"
                        Duration="0:0:0.1" />
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                  <Condition Binding="{Binding Source={markup:Service {x:Type services:WindowsPolicy}}, Path=IsEffectiveAnimationsDisabled}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation
                        Storyboard.TargetName="InnerBorder"
                        Storyboard.TargetProperty="Background.Color"
                        To="#99ffffff"
                        Duration="0" />
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation
                        Storyboard.TargetName="InnerBorder"
                        Storyboard.TargetProperty="Background.Color"
                        To="Transparent"
                        Duration="0" />
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Button.Resources>
</Button>
