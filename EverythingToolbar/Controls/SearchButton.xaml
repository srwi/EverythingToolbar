<Button
  x:Class="EverythingToolbar.Controls.SearchButton"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:markup="clr-namespace:EverythingToolbar.Markup"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:properties="clr-namespace:EverythingToolbar.Properties"
  xmlns:services="clr-namespace:EverythingToolbar.Services"
  d:DesignHeight="40"
  d:DesignWidth="40"
  Background="Transparent"
  Click="OnClick"
  IsVisibleChanged="OnIsVisibleChanged"
  Style="{DynamicResource SearchButtonStyle}"
  ToolTip="{x:Static properties:Resources.TextBoxWatermark}"
  mc:Ignorable="d">
  <Button.Resources>
    <Style x:Key="SearchButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid>
              <Border
                x:Name="ButtonBorder"
                Background="{DynamicResource SearchButtonBackgroundIdle}"
                BorderBrush="Transparent"
                BorderThickness="{DynamicResource SearchButtonBorderThickness}"
                CornerRadius="{DynamicResource SearchButtonCornerRadius}"
                SnapsToDevicePixels="True" />
              <Border
                x:Name="HoverBorder"
                Background="{DynamicResource SearchButtonBackgroundHover}"
                BorderBrush="{DynamicResource SearchButtonBorderHover}"
                BorderThickness="{DynamicResource SearchButtonBorderThickness}"
                CornerRadius="{DynamicResource SearchButtonCornerRadius}"
                Opacity="0"
                SnapsToDevicePixels="True" />
              <Image
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                RenderOptions.BitmapScalingMode="Fant"
                Source="{Binding IconSource}" />
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SearchButtonBackgroundActive}" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource SearchButtonBorderActive}" />
              </DataTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HoverBorder" Property="Background" Value="{DynamicResource SearchButtonBackgroundPressed}" />
                <Setter TargetName="HoverBorder" Property="BorderBrush" Value="{DynamicResource SearchButtonBorderPressed}" />
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                  <Condition Binding="{Binding Source={markup:Service {x:Type services:WindowsPolicy}}, Path=IsEffectiveAnimationsDisabled}" Value="False" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                        Storyboard.TargetName="HoverBorder"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.08" />
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                        Storyboard.TargetName="HoverBorder"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0:0:0.1" />
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                  <Condition Binding="{Binding Source={markup:Service {x:Type services:WindowsPolicy}}, Path=IsEffectiveAnimationsDisabled}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                        Storyboard.TargetName="HoverBorder"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0" />
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                        Storyboard.TargetName="HoverBorder"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0" />
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Button.Resources>
</Button>
