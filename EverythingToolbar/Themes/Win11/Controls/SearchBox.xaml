<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="SearchBoxIconStyle" TargetType="{x:Type Control}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Control}">
          <Path
            Margin="20 0 0 0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Stroke="{DynamicResource SearchBoxIconColor}"
            StrokeThickness="1.5">
            <Path.Data>
              <GeometryGroup>
                <LineGeometry StartPoint="10, 15" EndPoint="6, 11" />
                <EllipseGeometry
                  Center="2, 7"
                  RadiusX="5.3"
                  RadiusY="5.3" />
              </GeometryGroup>
            </Path.Data>
          </Path>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
