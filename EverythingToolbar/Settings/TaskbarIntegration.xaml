<Page x:Class="EverythingToolbar.Settings.TaskbarIntegration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:properties="clr-namespace:EverythingToolbar.Properties"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
      xmlns:c="clr-namespace:EverythingToolbar.Converters"
      xmlns:local="clr-namespace:EverythingToolbar"
      xmlns:controls="clr-namespace:EverythingToolbar.Controls"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False">

    <i:Interaction.Behaviors>
        <b:WpfUiBehavior />
    </i:Interaction.Behaviors>

    <Page.Resources>
        <DataTemplate x:Key="IconItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding IconPath}"
                       Width="24"
                       Height="24"
                       Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="Fant" />
                <TextBlock Text="{Binding DisplayName}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="40">
            <ui:TextBlock FontTypography="Title"
                          Text="{x:Static properties:Resources.SettingsTaskbarIntegration}"
                          Margin="0, 0, 0, 0"/>

            <StackPanel Visibility="{Binding IsLauncher, Converter={c:BoolToVisibilityConverter}}">
                <ui:TextBlock FontTypography="BodyStrong"
                              Text="{x:Static properties:Resources.SettingsTaskbarIcon}"
                              Margin="0, 25, 0, 7"/>
                <Border Padding="16"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="8,8,0,0">
                    <controls:SettingItem Title="{x:Static properties:Resources.SettingsSearchIcon}"
                                          HelpText="{x:Static properties:Resources.SettingsSearchIconHelp}">
                        <controls:SettingItem.SettingContent>
                            <ComboBox HorizontalAlignment="Right"
                                      MinWidth="150"
                                      IsEnabled="{Binding IsTaskbarIconPinned}"
                                      ItemsSource="{Binding IconItems}"
                                      SelectedItem="{Binding SelectedIconItem, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource IconItemTemplate}" />
                        </controls:SettingItem.SettingContent>
                    </controls:SettingItem>
                </Border>
                <Border Padding="16"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,1,1"
                        CornerRadius="0,0,8,8">
                    <controls:SettingItem Title="{x:Static properties:Resources.SettingsHideWindowsSearchIcon}"
                                          HelpText="{x:Static properties:Resources.SettingsHideWindowsSearchIconHelp}">
                        <controls:SettingItem.SettingContent>
                            <ui:ToggleSwitch IsChecked="{Binding IsWindowsSearchHidden, Mode=TwoWay}" />
                        </controls:SettingItem.SettingContent>
                    </controls:SettingItem>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowTaskbarWindowSettings, Converter={c:BoolToVisibilityConverter}}">
                <ui:TextBlock FontTypography="BodyStrong"
                              Text="{x:Static properties:Resources.SettingsTaskbarSearchBox}"
                              Margin="0, 25, 0, 7"/>
                <Border Padding="16"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="8,8,0,0">
                    <controls:SettingItem Title="{x:Static properties:Resources.SettingsTaskbarWindow}"
                                          HelpText="{x:Static properties:Resources.SettingsTaskbarWindowHelp}">
                        <controls:SettingItem.SettingContent>
                            <ui:ToggleSwitch IsChecked="{Binding Source={x:Static local:ToolbarSettings.User}, Path=TaskbarWindowEnabled, Mode=TwoWay}" />
                        </controls:SettingItem.SettingContent>
                    </controls:SettingItem>
                </Border>
                <Border Padding="16"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,1,1"
                        CornerRadius="0,0,8,8">
                    <controls:SettingItem Title="{x:Static properties:Resources.SettingsTaskbarWindowAlignment}"
                                          HelpText="{x:Static properties:Resources.SettingsTaskbarWindowAlignmentHelp}">
                        <controls:SettingItem.SettingContent>
                            <ComboBox HorizontalAlignment="Right"
                                      ItemsSource="{Binding TaskbarWindowAlignmentOptions}"
                                      DisplayMemberPath="Key"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Source={x:Static local:ToolbarSettings.User}, Path=TaskbarWindowAlignment, Mode=TwoWay}">
                                <ComboBox.IsEnabled>
                                    <MultiBinding Converter="{c:BooleanAndConverter}">
                                        <Binding Source="{x:Static local:ToolbarSettings.User}" Path="TaskbarWindowEnabled" />
                                        <Binding Path="AllowLeftAlignment" />
                                    </MultiBinding>
                                </ComboBox.IsEnabled>
                            </ComboBox>
                        </controls:SettingItem.SettingContent>
                    </controls:SettingItem>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding IsLauncher, Converter={c:BoolToVisibilityConverter}}">
                <ui:TextBlock FontTypography="BodyStrong"
                              Text="{x:Static properties:Resources.SettingsOther}"
                              Margin="0, 25, 0, 7"/>
                <Border Padding="16"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,1,1"
                        CornerRadius="8,8,8,8">
                    <controls:SettingItem Title="{x:Static properties:Resources.SettingsEnableSystemTrayIcon}"
                                          HelpText="{x:Static properties:Resources.SettingsEnableSystemTrayIconHelp}">
                        <controls:SettingItem.SettingContent>
                            <ui:ToggleSwitch IsChecked="{Binding Source={x:Static local:ToolbarSettings.User}, Path=IsTrayIconEnabled, Mode=TwoWay}" />
                        </controls:SettingItem.SettingContent>
                    </controls:SettingItem>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
