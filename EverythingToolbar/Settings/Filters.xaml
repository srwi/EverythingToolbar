<Page
  x:Class="EverythingToolbar.Settings.Filters"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:controls="clr-namespace:EverythingToolbar.Controls"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:properties="clr-namespace:EverythingToolbar.Properties"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.CanContentScroll="False">
  <i:Interaction.Behaviors>
    <b:Themed Surface="AppWindow" />
  </i:Interaction.Behaviors>

  <ScrollViewer>
    <StackPanel Margin="40">
      <ui:TextBlock
        Margin="0 0 0 25"
        FontTypography="Title"
        Text="{x:Static properties:Resources.SettingsFilters}" />
      <ui:TextBlock
        Margin="0 0 0 7"
        FontTypography="BodyStrong"
        Text="{x:Static properties:Resources.SettingsFilters}" />
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 0"
        CornerRadius="8,8,0,0">
        <controls:SettingItem Title="{x:Static properties:Resources.SettingsRememberFilter}" HelpText="{x:Static properties:Resources.SettingsRememberFilterHelp}">
          <controls:SettingItem.SettingContent>
            <ui:ToggleSwitch IsChecked="{Binding Settings.IsRememberFilter, Mode=TwoWay}" />
          </controls:SettingItem.SettingContent>
        </controls:SettingItem>
      </Border>
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 0"
        CornerRadius="0,0,0,0">
        <controls:SettingItem Title="{x:Static properties:Resources.SettingsUseEverythingFilters}" HelpText="{x:Static properties:Resources.SettingsEverythingFiltersHelp}">
          <controls:SettingItem.SettingContent>
            <ui:ToggleSwitch IsChecked="{Binding Settings.IsImportFilters, Mode=TwoWay}" />
          </controls:SettingItem.SettingContent>
        </controls:SettingItem>
      </Border>
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 0"
        CornerRadius="0,0,0,0">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Height" Value="Auto" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Settings.IsImportFilters}" Value="True">
                <Setter Property="Height" Value="0" />
                <Setter Property="IsEnabled" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <ui:TextBlock
            Margin="0 0 0 10"
            Text="{x:Static properties:Resources.SettingsFilterOrder}"
            TextWrapping="Wrap" />
          <ListBox
            Height="200"
            AllowDrop="True"
            Background="Transparent"
            BorderThickness="0"
            DragOver="OnOrderListDragOver"
            Drop="OnOrderListDrop"
            ItemsSource="{Binding FilterOrderItems}"
            ScrollViewer.CanContentScroll="False">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border
                  Margin="0 2"
                  Padding="8"
                  Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                  BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Cursor="Hand">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                      Grid.Column="0"
                      Margin="0 0 8 0"
                      FontSize="16"
                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                      Symbol="ReOrderDotsHorizontal24" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="{Binding Name}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <EventSetter Event="MouseMove" Handler="OnOrderListItemMouseMove" />
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnOrderListItemMouseDown" />
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </StackPanel>
      </Border>
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 1"
        CornerRadius="0,0,8,8">
        <controls:SettingItem Title="{x:Static properties:Resources.SettingsMaxTabItems}" HelpText="{x:Static properties:Resources.SettingsMaxTabItemsHelp}">
          <controls:SettingItem.SettingContent>
            <ui:NumberBox
              Width="120"
              Minimum="0"
              Value="{Binding Settings.MaxTabItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </controls:SettingItem.SettingContent>
        </controls:SettingItem>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
