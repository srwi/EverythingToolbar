<Page
  x:Class="EverythingToolbar.Settings.CustomActions"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:appdata="clr-namespace:EverythingToolbar.App.Data;assembly=EverythingToolbar.App"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:core="clr-namespace:System;assembly=mscorlib"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:properties="clr-namespace:EverythingToolbar.Properties"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Loaded="OnLoaded"
  ScrollViewer.CanContentScroll="False"
  Unloaded="OnUnloaded">
  <i:Interaction.Behaviors>
    <b:Themed Surface="AppWindow" />
  </i:Interaction.Behaviors>

  <Page.Resources>
    <ObjectDataProvider
      x:Key="FileTypeEnum"
      MethodName="GetValues"
      ObjectType="{x:Type core:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type Type="appdata:FileType" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <DrawingBrush
      x:Key="ErrorBackgroundBrush"
      Stretch="UniformToFill"
      TileMode="Tile"
      Viewport="0,0,10,10"
      ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <DrawingGroup.Children>
            <GeometryDrawing Brush="#55bb0000">
              <GeometryDrawing.Geometry>
                <GeometryGroup FillRule="Nonzero">
                  <PathGeometry>
                    <PathFigure StartPoint="0,0">
                      <LineSegment Point="25,0" />
                      <LineSegment Point="100,75" />
                      <LineSegment Point="100,100" />
                      <LineSegment Point="75,100" />
                      <LineSegment Point="0,25" />
                      <LineSegment Point="0,0" />
                    </PathFigure>
                    <PathFigure StartPoint="75,0">
                      <LineSegment Point="100,25" />
                      <LineSegment Point="100,0" />
                    </PathFigure>
                    <PathFigure StartPoint="0,75">
                      <LineSegment Point="25,100" />
                      <LineSegment Point="0,100" />
                    </PathFigure>
                  </PathGeometry>
                </GeometryGroup>
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
          </DrawingGroup.Children>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Page.Resources>

  <ScrollViewer>
    <StackPanel Margin="40">
      <ui:TextBlock
        Margin="0 0 0 25"
        FontTypography="Title"
        Text="{x:Static properties:Resources.SettingsCustomActions}" />
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1 1 1 0"
        CornerRadius="8, 8, 0, 0">
        <CheckBox
          Name="AutoApplyCustomActionsCheckbox"
          Click="CheckBox_Click"
          Content="{x:Static properties:Resources.CustomActionsAutoApply}" />
      </Border>
      <Border
        Padding="16"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="0, 0, 8, 8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ui:DataGrid
            x:Name="DataGrid"
            Grid.Column="0"
            Margin="0 0 0 10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AlternatingRowBackground="Transparent"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserSortColumns="False"
            HorizontalScrollBarVisibility="Disabled"
            RowBackground="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            SelectionChanged="OnGridSelectionChanged">
            <ui:DataGrid.Columns>
              <DataGridTextColumn
                Width="1.5*"
                Binding="{Binding Name}"
                Header="{x:Static properties:Resources.CustomActionsName}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Name}" Value="">
                        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
                        <Setter Property="Height" Value="37" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Width="1*" Header="{x:Static properties:Resources.CustomActionsType}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox
                      Background="Transparent"
                      BorderThickness="0"
                      IsEditable="False"
                      ItemsSource="{Binding Source={StaticResource FileTypeEnum}, Mode=OneWay}"
                      SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn
                x:Name="ExpressionColumn"
                Width="2.5*"
                Binding="{Binding Expression}"
                Header="{x:Static properties:Resources.CustomActionsRegularExpression}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ExpressionValid}" Value="False">
                        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
                        <Setter Property="Height" Value="37" />
                        <Setter Property="Padding" Value="0 8 0 0" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn
                Width="2*"
                Binding="{Binding Command}"
                Header="{x:Static properties:Resources.CustomActionsCommand}" />
            </ui:DataGrid.Columns>
          </ui:DataGrid>

          <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="20 0 0 0">
            <ui:Button
              Height="37"
              Margin="0 0 0 10"
              Click="AddItem"
              Icon="{ui:SymbolIcon Add12}" />
            <ui:Button
              Name="DeleteButton"
              Height="37"
              Margin="0 0 0 10"
              Click="DeleteSelected"
              Icon="{ui:SymbolIcon Subtract12}" />
            <ui:Button
              Name="MoveUpButton"
              Height="37"
              Margin="0 0 0 10"
              Click="MoveUpSelected"
              Icon="{ui:SymbolIcon ArrowUp12}" />
            <ui:Button
              Name="MoveDownButton"
              Height="37"
              Margin="0 0 0 10"
              Click="MoveDownSelected"
              Icon="{ui:SymbolIcon ArrowDown12}" />
          </StackPanel>

          <ui:InfoBar
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Static properties:Resources.CustomActionsHelpText}" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
