<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:EverythingToolbar.Converters"
  xmlns:controls="clr-namespace:EverythingToolbar.Controls">
  <Style TargetType="{x:Type TextBox}">
    <Setter Property="MaxHeight" Value="{DynamicResource TextBoxMaxHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={c:FontSizeFromHeightConverter}, FallbackValue=15.0}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextBoxWatermarkForeground}" />
    <Setter Property="Padding" Value="0 2" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBoxForegroundActive}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border
            x:Name="TextBoxBorder"
            controls:SearchBox.CornerRadiusRatio="{DynamicResource TextBoxCornerRadiusRatio}"
            Background="{DynamicResource TextBoxBackground}"
            BorderBrush="{DynamicResource TextBoxBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource TextBoxCornerRadius}">
            <Grid x:Name="TextBoxGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ContentPresenter
                Grid.Column="0"
                VerticalAlignment="Stretch"
                Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:SearchBox.LeadingContent)}" />

              <Grid
                Grid.Column="1"
                Margin="0 0 8 0"
                VerticalAlignment="Center">
                <TextBlock
                  x:Name="TextBoxWatermark"
                  Margin="2 0 0 0"
                  Padding="{TemplateBinding Padding}"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource TextBoxWatermarkForeground}"
                  IsHitTestVisible="False"
                  Opacity="0"
                  Text="{TemplateBinding Tag}"
                  TextTrimming="WordEllipsis" />
                <ScrollViewer
                  x:Name="PART_ContentHost"
                  Padding="{TemplateBinding Padding}"
                  VerticalAlignment="Center"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Hidden" />
              </Grid>

              <ContentPresenter
                Grid.Column="2"
                VerticalAlignment="Stretch"
                Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:SearchBox.TrailingContent)}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Control.IsMouseOver" Value="true">
              <Setter TargetName="TextBoxBorder" Property="Background" Value="{DynamicResource TextBoxBackgroundHover}" />
              <Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="1" />
              <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource TextBoxBorderHover}" />
              <Setter TargetName="TextBoxWatermark" Property="Foreground" Value="{DynamicResource TextBoxWatermarkForegroundHover}" />
            </Trigger>
            <Trigger Property="Control.IsKeyboardFocused" Value="true">
              <Setter TargetName="TextBoxBorder" Property="Background" Value="{DynamicResource TextBoxBackgroundActive}" />
              <Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="{DynamicResource TextBoxBorderActiveThickness}" />
              <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource TextBoxBorderActive}" />
              <Setter TargetName="TextBoxWatermark" Property="Foreground" Value="{DynamicResource TextBoxWatermarkForegroundActive}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBoxForegroundActive}" />
            </Trigger>
            <Trigger Property="Text" Value="">
              <Setter TargetName="TextBoxWatermark" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
