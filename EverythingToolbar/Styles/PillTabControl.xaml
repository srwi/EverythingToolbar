<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="{x:Type TabItem}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Border
            x:Name="Border"
            Height="32"
            Margin="0 0 4 0"
            Padding="14 0"
            Background="{DynamicResource TabBackground}"
            BorderBrush="{DynamicResource TabBorder}"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel Margin="0 0 0 0" Orientation="Horizontal">
              <TextBlock
                x:Name="ContentSiteIcon"
                Margin="0 0 8 0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="10pt"
                Foreground="{DynamicResource TabForeground}"
                Text="{Binding Icon}"
                TextAlignment="Center" />
              <TextBlock
                x:Name="ContentSite"
                Margin="0 0 0 2"
                VerticalAlignment="Center"
                FontSize="10pt"
                Foreground="{DynamicResource TabForeground}"
                Text="{Binding Name}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=ContentSiteIcon}" Value="">
              <Setter TargetName="ContentSiteIcon" Property="Margin" Value="0" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ContentSite" Property="Foreground" Value="{DynamicResource TabForegroundHover}" />
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabBackgroundHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ContentSite" Property="FontWeight" Value="Medium" />
              <Setter TargetName="ContentSite" Property="Foreground" Value="{DynamicResource TabForegroundActive}" />
              <Setter TargetName="ContentSiteIcon" Property="FontWeight" Value="Medium" />
              <Setter TargetName="ContentSiteIcon" Property="Foreground" Value="{DynamicResource TabForegroundActive}" />
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentColor}" />
              <Setter TargetName="Border" Property="BorderThickness" Value="0" />
              <Setter TargetName="Border" Property="Padding" Value="15 1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type TabControl}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <TabPanel
            Panel.ZIndex="1"
            Background="Transparent"
            IsItemsHost="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
