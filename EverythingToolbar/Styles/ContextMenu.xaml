<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:markup="clr-namespace:EverythingToolbar.Markup"
  xmlns:services="clr-namespace:EverythingToolbar.Services">
  <!--
    The popup hosting a ContextMenu is created by WPF, which resource-references the system menu
    animation for it. Opt out of it here so the fade-in below stays under our own control.
  -->
  <PopupAnimation x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>

  <Style TargetType="{x:Type MenuItem}">
    <Setter Property="Background" Value="{DynamicResource ContextMenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ContextMenuBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ContextMenuItemForeground}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border
            x:Name="Border"
            Margin="{DynamicResource ContextMenuMenuItemMargin}"
            Padding="5 5 5 5"
            Background="{TemplateBinding Background}"
            CornerRadius="{DynamicResource ContextMenuMenuItemCornerRadius}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  x:Name="Col0"
                  Width="Auto"
                  MinWidth="28"
                  SharedSizeGroup="MenuItemIconColumnGroup" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuTextColumnGroup" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                <ColumnDefinition x:Name="Col3" Width="20" />
              </Grid.ColumnDefinitions>
              <ContentPresenter
                x:Name="Icon"
                Grid.Column="0"
                Margin="8 0 6 0"
                VerticalAlignment="Center"
                ContentSource="Icon"
                TextBlock.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
              <Grid
                x:Name="GlyphPanel"
                Grid.Column="0"
                Margin="7 0 6 0"
                VerticalAlignment="Center"
                Visibility="Hidden">
                <Path
                  x:Name="GlyphPanelpath"
                  VerticalAlignment="Center"
                  Data="M0,6 L4,10 L12,0"
                  FlowDirection="LeftToRight"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="0.8" />
              </Grid>
              <ContentPresenter
                x:Name="HeaderHost"
                Grid.Column="1"
                Margin="7 0 0 0"
                VerticalAlignment="Center"
                ContentSource="Header"
                RecognizesAccessKey="True" />
              <ContentPresenter
                x:Name="IGTHost"
                Grid.Column="2"
                Margin="8 1 8 1"
                VerticalAlignment="Center"
                ContentSource="InputGestureText" />
              <Grid
                x:Name="ArrowPanel"
                Grid.Column="3"
                Margin="4 0 0 0"
                VerticalAlignment="Center">
                <Path
                  x:Name="ArrowPanelPath"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Data="M0,0 L6,6 L0,12"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="0.8" />
              </Grid>
              <Popup
                x:Name="SubMenuPopup"
                AllowsTransparency="True"
                IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                Placement="Right">
                <Grid x:Name="SubMenuBorder" Margin="{DynamicResource ContextMenuDropShadowMargin}">
                  <Grid.RenderTransform>
                    <TranslateTransform />
                  </Grid.RenderTransform>
                  <Border Background="{DynamicResource ContextMenuBackground}" CornerRadius="{DynamicResource ContextMenuCornerRadius}">
                    <Border.Effect>
                      <DropShadowEffect
                        BlurRadius="{DynamicResource ContextMenuDropShadowRadius}"
                        Opacity="0.3"
                        ShadowDepth="0"
                        Color="Black" />
                    </Border.Effect>
                  </Border>
                  <Border
                    Padding="0 4"
                    Background="{DynamicResource ContextMenuBackground}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource ContextMenuCornerRadius}">
                    <Grid x:Name="SubMenu" Grid.IsSharedSizeScope="True">
                      <StackPanel
                        Grid.IsSharedSizeScope="True"
                        IsItemsHost="True"
                        KeyboardNavigation.DirectionalNavigation="Cycle"
                        Style="{x:Null}" />
                    </Grid>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
              <Setter Property="Padding" Value="6 1 6 1" />
              <Setter TargetName="Col0" Property="MinWidth" Value="0" />
              <Setter TargetName="Col3" Property="Width" Value="Auto" />
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="GlyphPanel" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="IGTHost" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="ArrowPanel" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
              <Setter Property="Padding" Value="6 1 6 1" />
              <Setter Property="Width" Value="110" />
              <Setter TargetName="ArrowPanel" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter Property="DockPanel.Dock" Value="Top" />
              <Setter Property="Padding" Value="0 2 0 2" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
              <Setter Property="DockPanel.Dock" Value="Top" />
              <Setter Property="Padding" Value="0 2 0 2" />
              <Setter Property="Background" Value="Transparent" />
              <Setter TargetName="ArrowPanel" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSuspendingPopupAnimation" Value="True">
              <Setter TargetName="SubMenuPopup" Property="PopupAnimation" Value="None" />
            </Trigger>
            <Trigger Property="IsSuspendingPopupAnimation" Value="False">
              <Setter TargetName="SubMenuPopup" Property="PopupAnimation" Value="None" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="GlyphPanel" Property="Visibility" Value="Visible" />
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource ContextMenuItemForegroundHover}" />
              <Setter Property="Background" Value="{DynamicResource ContextMenuItemBackgroundHover}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="SubMenuPopup" Property="PopupAnimation" Value="None" />
              <Setter Property="Background" Value="{DynamicResource ContextMenuItemBackgroundHover}" />
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsSubmenuOpen, RelativeSource={RelativeSource Self}}" Value="True" />
                <Condition Binding="{Binding Source={markup:Service {x:Type services:WindowsPolicy}}, Path=IsEffectiveAnimationsDisabled}" Value="False" />
              </MultiDataTrigger.Conditions>
              <MultiDataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="SubMenuBorder"
                      Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                      From="-90"
                      To="0"
                      Duration="00:00:00.167">
                      <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
    <Setter Property="Background" Value="{DynamicResource ContextMenuSeparator}" />
    <Setter Property="Margin" Value="11 7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border
            Height="1"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ContextMenu}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Grid.IsSharedSizeScope" Value="True" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Grid x:Name="Border" Margin="{DynamicResource ContextMenuDropShadowMargin}">
            <Grid.RenderTransform>
              <TranslateTransform />
            </Grid.RenderTransform>
            <Border Background="{DynamicResource ContextMenuBackground}" CornerRadius="{DynamicResource ContextMenuCornerRadius}">
              <Border.Effect>
                <DropShadowEffect
                  BlurRadius="{DynamicResource ContextMenuDropShadowRadius}"
                  Opacity="0.3"
                  ShadowDepth="0"
                  Color="Black" />
              </Border.Effect>
            </Border>
            <Border
              Padding="0 4"
              Background="{DynamicResource ContextMenuBackground}"
              BorderBrush="{DynamicResource ContextMenuBorder}"
              BorderThickness="1"
              CornerRadius="{DynamicResource ContextMenuCornerRadius}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsOpen, RelativeSource={RelativeSource Self}}" Value="True" />
                <Condition Binding="{Binding Source={markup:Service {x:Type services:WindowsPolicy}}, Path=IsEffectiveAnimationsDisabled}" Value="False" />
              </MultiDataTrigger.Conditions>
              <MultiDataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="Border"
                      Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                      From="-90"
                      To="0"
                      Duration="00:00:00.167">
                      <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation
                      Storyboard.TargetName="Border"
                      Storyboard.TargetProperty="(UIElement.Opacity)"
                      From="0"
                      To="1"
                      Duration="00:00:00.167" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
