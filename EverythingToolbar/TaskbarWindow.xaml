<Window x:Class="EverythingToolbar.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
        xmlns:controls="clr-namespace:EverythingToolbar.Controls"
        Title="EverythingToolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="300"
        Height="32">

    <i:Interaction.Behaviors>
        <b:ThemeAwareness />
        <b:WpfUiBehavior />
    </i:Interaction.Behaviors>

    <controls:ToolbarControl x:Name="ToolbarControl"
                             IsFixedLayout="True"
                             AddPlacementBehavior="False" />
</Window>
