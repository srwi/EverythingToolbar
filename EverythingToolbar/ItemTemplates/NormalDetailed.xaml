<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:EverythingToolbar.Helpers;assembly=EverythingToolbar"
                    xmlns:b="clr-namespace:EverythingToolbar.Behaviors;assembly=EverythingToolbar">

    <DataTemplate x:Key="SearchResultsViewTemplate">
        <Grid x:Name="ListViewItem" Margin="0, 0, 0, 4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image b:ResultIcon.Result="{Binding}"
                   Grid.RowSpan="2"
                   Width="24"
                   Height="24" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center" />
            <TextBlock h:HighlightedText.Source="{Binding HighlightedFileName, Mode=OneTime}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="12pt"
                       Grid.Column="1"
                       VerticalAlignment="Bottom"
                       Margin="0, 7, 0, 4"
                       ToolTip="{Binding FileName}"
                       Foreground="{DynamicResource SearchResultFileName}" />
            <TextBlock h:HighlightedText.Source="{Binding HighlightedPath, Mode=OneTime}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="10pt"
                       ToolTip="{Binding Path}"
                       Grid.Column="1"
                       Grid.Row="1"
                       VerticalAlignment="Top"
                       Margin="0, 0, 0, 4"
                       Foreground="{DynamicResource SearchResultPath}" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Bottom"
                       Margin="10, 5, 10, 6"
                       FontSize="10pt"
                       Foreground="{DynamicResource SearchResultDateModified}"
                       Text="{Binding HumanReadableDateModified}" />
            <TextBlock Grid.Column="2"
                       Grid.Row="1"
                       VerticalAlignment="Top"
                       Margin="10, 0, 10, 4"
                       HorizontalAlignment="Right"
                       FontSize="10pt"
                       Foreground="{DynamicResource SearchResultFileSize}"
                       Text="{Binding HumanReadableFileSize}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>