<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:h="clr-namespace:EverythingToolbar.Helpers">
  <DataTemplate x:Key="NormalDetailed">
    <Grid x:Name="ListViewItem" Margin="0 0 0 4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Image
        Grid.RowSpan="2"
        Width="24"
        Height="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        b:ResultIcon.Result="{Binding Mode=OneTime}" />
      <TextBlock
        Grid.Column="1"
        Margin="0 7 0 4"
        VerticalAlignment="Bottom"
        h:HighlightedText.Source="{Binding HighlightedFileName, Mode=OneTime}"
        FontSize="12pt"
        Foreground="{DynamicResource SearchResultFileName}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding FileName, Mode=OneTime}" />
      <TextBlock
        Grid.Row="1"
        Grid.Column="1"
        Margin="0 0 0 4"
        VerticalAlignment="Top"
        h:HighlightedText.Source="{Binding HighlightedPath, Mode=OneTime}"
        FontSize="10pt"
        Foreground="{DynamicResource SearchResultPath}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding Path, Mode=OneTime}" />
      <TextBlock
        Grid.Column="2"
        Margin="10 5 10 6"
        VerticalAlignment="Bottom"
        FontSize="10pt"
        Foreground="{DynamicResource SearchResultDateModified}"
        Text="{Binding HumanReadableDateModified, Mode=OneTime}" />
      <TextBlock
        Grid.Row="1"
        Grid.Column="2"
        Margin="10 0 10 4"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        FontSize="10pt"
        Foreground="{DynamicResource SearchResultFileSize}"
        Text="{Binding HumanReadableFileSize, Mode=OneTime}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
