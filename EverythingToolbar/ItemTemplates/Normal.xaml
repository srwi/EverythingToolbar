<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:EverythingToolbar.Helpers;assembly=EverythingToolbar">
    
    <DataTemplate x:Key="SearchResultsViewTemplate">
        <Grid x:Name="ListViewItem" Margin="0, 0, 0, 4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="{Binding Icon}"
                   Width="16"
                   Height="16"
                   Margin="0, 5, 0, 0" />
            <TextBlock h:HighlightedText.Source="{Binding HighlightedFileName, Mode=OneTime}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="12pt"
                       Grid.Column="1"
                       VerticalAlignment="Bottom"
                       Margin="0, 7, 0, 4"
                       ToolTip="{Binding FileName}"
                       Foreground="{DynamicResource SearchResultFileName}" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Bottom"
                       Margin="10, 5, 10, 6"
                       FontSize="10pt"
                       Foreground="{DynamicResource SearchResultDateModified}"
                       Text="{Binding HumanReadableDateModified}" />
        </Grid>
    </DataTemplate>
    
</ResourceDictionary>