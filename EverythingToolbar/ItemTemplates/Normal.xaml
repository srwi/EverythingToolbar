<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:h="clr-namespace:EverythingToolbar.Helpers">
  <DataTemplate x:Key="Normal">
    <Grid x:Name="ListViewItem" Margin="0 0 0 4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image
        Width="16"
        Height="16"
        Margin="0 5 0 0"
        b:ResultIcon.Result="{Binding Mode=OneTime}" />
      <TextBlock
        Grid.Column="1"
        Margin="0 7 0 4"
        VerticalAlignment="Bottom"
        h:HighlightedText.Source="{Binding HighlightedFileName, Mode=OneTime}"
        FontSize="12pt"
        Foreground="{DynamicResource SearchResultFileName}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding FileName, Mode=OneTime}" />
      <TextBlock
        Grid.Column="2"
        Margin="10 5 10 6"
        VerticalAlignment="Bottom"
        FontSize="10pt"
        Foreground="{DynamicResource SearchResultDateModified}"
        Text="{Binding HumanReadableDateModified, Mode=OneTime}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
