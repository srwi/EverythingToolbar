<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors"
  xmlns:h="clr-namespace:EverythingToolbar.Helpers">
  <DataTemplate x:Key="Compact">
    <Grid x:Name="ListViewItem" Margin="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image
        Width="16"
        Height="16"
        b:ResultIcon.Result="{Binding}" />
      <TextBlock
        Grid.Column="1"
        Margin="2 0"
        h:HighlightedText.Source="{Binding HighlightedFileName, Mode=OneTime}"
        FontSize="9pt"
        Foreground="{DynamicResource SearchResultFileName}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding FileName}" />
      <TextBlock
        Grid.Column="2"
        Margin="2 0"
        FontSize="9pt"
        Foreground="{DynamicResource SearchResultDateModified}"
        Text="{Binding HumanReadableDateModified}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
