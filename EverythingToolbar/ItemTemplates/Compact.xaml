<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:EverythingToolbar.Helpers;assembly=EverythingToolbar">
    
    <DataTemplate x:Key="SearchResultsViewTemplate">
        <Grid x:Name="ListViewItem" Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="{Binding Icon}"
                   Width="16"
                   Height="16" />
            <TextBlock h:HighlightedText.Source="{Binding HighlightedFileName, Mode=OneTime}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="9pt"
                       Grid.Column="1"
                       Margin="2, 0"
                       ToolTip="{Binding FileName}"
                       Foreground="{DynamicResource SearchResultFileName}" />
            <TextBlock Grid.Column="2"
                       FontSize="9pt"
                       Margin="2, 0"
                       Foreground="{DynamicResource SearchResultDateModified}"
                       Text="{Binding HumanReadableDateModified}" />
        </Grid>
    </DataTemplate>
    
</ResourceDictionary>