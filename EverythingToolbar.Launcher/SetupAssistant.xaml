<ui:FluentWindow
  x:Class="EverythingToolbar.Launcher.SetupAssistant"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="clr-namespace:EverythingToolbar.Behaviors;assembly=EverythingToolbar"
  xmlns:c="clr-namespace:EverythingToolbar.Converters;assembly=EverythingToolbar"
  xmlns:controls="clr-namespace:EverythingToolbar.Controls;assembly=EverythingToolbar"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:properties="clr-namespace:EverythingToolbar.Launcher.Properties"
  xmlns:sprops="clr-namespace:EverythingToolbar.Properties;assembly=EverythingToolbar"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="{x:Static properties:Resources.SetupAssistantTitle}"
  Background="{DynamicResource ApplicationBackgroundBrush}"
  Closed="OnClosed"
  Closing="OnClosing"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ResizeMode="NoResize"
  SizeToContent="Height"
  Topmost="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen">
  <ui:FluentWindow.Resources>
    <Storyboard x:Key="WiggleStoryboard">
      <DoubleAnimationUsingKeyFrames
        Storyboard.TargetName="WiggleTransform"
        Storyboard.TargetProperty="X"
        Duration="0:0:0.5">
        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="15" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="-15" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="15" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="-15" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </ui:FluentWindow.Resources>

  <i:Interaction.Behaviors>
    <b:FlowDirectionAwareness />
    <b:Themed Surface="AppWindow" />
  </i:Interaction.Behaviors>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Title="{x:Static properties:Resources.SetupAssistantTitle}"
      Grid.Row="0"
      ShowMaximize="False"
      ShowMinimize="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/EverythingToolbar;component/Images/AppIcon.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <StackPanel Grid.Row="1" Margin="40 10 40 20">
      <ui:TextBlock
        Margin="0 0 0 10"
        FontTypography="BodyStrong"
        Text="{x:Static properties:Resources.SetupAssistantChooseAccess}"
        Visibility="{Binding IsTaskbarWindowSupported, Converter={c:BoolToVisibilityConverter}}" />

      <!--  Two ways to open EverythingToolbar, presented side by side as a choice.  -->
      <Grid>
        <Grid.RenderTransform>
          <TranslateTransform x:Name="WiggleTransform" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition>
            <ColumnDefinition.Style>
              <Style TargetType="ColumnDefinition">
                <Setter Property="Width" Value="0" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsTaskbarWindowSupported}" Value="True">
                    <Setter Property="Width" Value="*" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ColumnDefinition.Style>
          </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!--  Option 1: pin the taskbar icon (+ its related settings)  -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinOptionAvailable}" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Border
            Padding="16"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1 1 1 0"
            CornerRadius="8,8,0,0">
            <StackPanel>
              <Grid>
                <Image RenderOptions.BitmapScalingMode="Fant" Source="Images/PinToTaskbar.png">
                  <Image.Style>
                    <Style TargetType="Image">
                      <Setter Property="Opacity" Value="1" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                          <Setter Property="Opacity" Value="0.2" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Image.Style>
                </Image>
                <ui:SymbolIcon
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="64"
                  Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                  Symbol="Checkmark24">
                  <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
              </Grid>
              <controls:SettingItem
                Title="{x:Static properties:Resources.SetupAssistantPinToTaskbar}"
                Margin="0 16 0 0"
                HelpText="{x:Static properties:Resources.SetupAssistantPinToTaskbarHelp}" />
            </StackPanel>
          </Border>
          <Border
            Padding="16"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1 1 1 1"
            CornerRadius="0,0,8,8">
            <controls:SettingItem Title="{x:Static properties:Resources.SetupAssistantHideWindowsSearch}" HelpText="{x:Static properties:Resources.SetupAssistantHideWindowsSearchHelp}">
              <controls:SettingItem.SettingContent>
                <ui:ToggleSwitch IsChecked="{Binding WindowsSearchHidden, Mode=TwoWay}" />
              </controls:SettingItem.SettingContent>
            </controls:SettingItem>
          </Border>
        </StackPanel>

        <!--  Vertical "or" divider  -->
        <Grid
          Grid.Column="1"
          Margin="16 0 16 0"
          Visibility="{Binding IsTaskbarWindowSupported, Converter={c:BoolToVisibilityConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Rectangle
            Grid.Row="0"
            Width="1"
            HorizontalAlignment="Center"
            Fill="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
          <ui:TextBlock
            Grid.Row="1"
            Margin="0 8 0 8"
            HorizontalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{x:Static properties:Resources.SetupAssistantOr}" />
          <Rectangle
            Grid.Row="2"
            Width="1"
            HorizontalAlignment="Center"
            Fill="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
        </Grid>

        <!--  Option 2: taskbar search box (+ its related settings), Windows 11+  -->
        <StackPanel
          Grid.Column="2"
          VerticalAlignment="Top"
          Visibility="{Binding IsTaskbarWindowSupported, Converter={c:BoolToVisibilityConverter}}">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsWindowOptionAvailable}" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Border
            Padding="16"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1 1 1 0"
            CornerRadius="8,8,0,0">
            <StackPanel>
              <Image RenderOptions.BitmapScalingMode="Fant" Source="Images/TaskbarSearchBox.png" />
              <controls:SettingItem
                Title="{x:Static properties:Resources.SetupAssistantTaskbarWindowOption}"
                Margin="0 16 0 0"
                HelpText="{x:Static properties:Resources.SetupAssistantTaskbarWindowAlternativeHelp}">
                <controls:SettingItem.SettingContent>
                  <ui:ToggleSwitch IsChecked="{Binding Settings.TaskbarWindowEnabled, Mode=TwoWay}" />
                </controls:SettingItem.SettingContent>
              </controls:SettingItem>
            </StackPanel>
          </Border>
          <Border
            Padding="16"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1 1 1 1"
            CornerRadius="0,0,8,8">
            <controls:SettingItem Title="{x:Static sprops:Resources.SettingsTaskbarWindowAlignment}" HelpText="{x:Static sprops:Resources.SettingsTaskbarWindowAlignmentHelp}">
              <controls:SettingItem.SettingContent>
                <ComboBox
                  HorizontalAlignment="Right"
                  DisplayMemberPath="Key"
                  ItemsSource="{Binding TaskbarWindowAlignmentOptions}"
                  SelectedValue="{Binding Settings.TaskbarWindowAlignment, Mode=TwoWay}"
                  SelectedValuePath="Value">
                  <ComboBox.IsEnabled>
                    <MultiBinding Converter="{c:BooleanAndConverter}">
                      <Binding Path="Settings.TaskbarWindowEnabled" />
                      <Binding Path="AllowLeftAlignment" />
                    </MultiBinding>
                  </ComboBox.IsEnabled>
                </ComboBox>
              </controls:SettingItem.SettingContent>
            </controls:SettingItem>
          </Border>
        </StackPanel>
      </Grid>

      <!--
        Settings that apply regardless of the chosen option. Until one of the options
        above is active, this section is disabled and clicking it wiggles the cards.
      -->
      <Border Background="Transparent" MouseLeftButtonDown="OnSecondStepClicked">
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Opacity" Value="0.2" />
              <Setter Property="IsEnabled" Value="False" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding PreferencesUnlocked}" Value="True">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <ui:TextBlock
            Margin="0 24 0 7"
            FontTypography="BodyStrong"
            Text="{x:Static properties:Resources.SetupAssistantPreferences}" />
          <Border
            Padding="16"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1 1 1 0"
            CornerRadius="8,8,0,0">
            <controls:SettingItem Title="{x:Static properties:Resources.SetupAssistantEnableSystemTray}" HelpText="{x:Static properties:Resources.SetupAssistantEnableSystemTrayHelp}">
              <controls:SettingItem.SettingContent>
                <ui:ToggleSwitch IsChecked="{Binding Settings.IsTrayIconEnabled, Mode=TwoWay}" />
              </controls:SettingItem.SettingContent>
            </controls:SettingItem>
          </Border>
          <Border
            Padding="16"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1 1 1 1"
            CornerRadius="0,0,8,8">
            <controls:SettingItem Title="{x:Static properties:Resources.SetupAssistantEnableAutostart}" HelpText="{x:Static properties:Resources.SetupAssistantEnableAutostartHelp}">
              <controls:SettingItem.SettingContent>
                <ui:ToggleSwitch IsChecked="{Binding AutostartEnabled, Mode=TwoWay}" />
              </controls:SettingItem.SettingContent>
            </controls:SettingItem>
          </Border>

          <ui:Button
            Height="40"
            Margin="0 20 0 0"
            HorizontalAlignment="Center"
            Click="Close"
            Content="{x:Static properties:Resources.SetupAssistantDone}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
